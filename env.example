# FIN base URL, no trailing slash
FIN_URL=https://fin.example.com

# API token from: php api.php create-api-token (reads and plan-amount writes)
FIN_TOKEN=paste_token_here

# Hostname only, no scheme or path
PUBLIC_HOSTNAME=fin-mcp.example.com

# OIDC provider that issues the access tokens
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=your-client-id

# Interface to listen on. 0.0.0.0 = all, or a specific LAN address
HOST=0.0.0.0
PORT=3940
